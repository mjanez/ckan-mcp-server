# Ejemplo de configuración de variables de entorno
# Copiar a .env y personalizar

# URL del portal CKAN (obligatorio)
CKAN_URL=https://catalogo.datosabiertos.miteco.gob.es/catalogo

# API Key de CKAN (opcional, solo para operaciones autenticadas)
# Obtener desde: Portal CKAN > User Profile > API Tokens
CKAN_API_KEY=

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# User Agent personalizado (opcional)
# USER_AGENT=mi-aplicacion/1.0

# Timeout de requests en segundos (opcional)
# REQUEST_TIMEOUT=30

# Número máximo de reintentos (opcional)
# MAX_RETRIES=3
